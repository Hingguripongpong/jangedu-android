# Copy to keystore.properties (git-ignored) and fill in. Paths are relative to the android/ folder.
# Create the keystore once (keep it safe - Play App Signing uses it as your *upload* key):
#   keytool -genkeypair -v -keystore release.jks -alias janggi -keyalg RSA -keysize 4096 -validity 10000
storeFile=release.jks
storePassword=CHANGE_ME
keyAlias=janggi
keyPassword=CHANGE_ME
